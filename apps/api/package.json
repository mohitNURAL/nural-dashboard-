{
  "name": "@nural/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "bitrix:ping": "tsx src/scripts/bitrixPing.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/dbMigrate.ts",
    "sync:initial": "tsx src/scripts/syncInitial.ts",
    "sync:verify": "tsx src/scripts/syncVerify.ts",
    "hooks:simulate": "tsx src/scripts/hooksSimulate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^9.0.1",
    "@nural/shared": "workspace:*",
    "bullmq": "^5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.0",
    "ioredis": "^5",
    "pg": "^8.23.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2"
  }
}
