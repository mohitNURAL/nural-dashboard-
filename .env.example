# Copy to .env and fill in. Never commit .env.
BITRIX_INBOUND_URL=https://nural.bitrix24.in/rest/<user_id>/<secret>/
BITRIX_OUTBOUND_TOKEN=
# Empty = all workgroups. Or a comma list, e.g. 148,154
DEV_GROUP_IDS=
DATABASE_URL=postgres://dash:dash@localhost:5433/dash
REDIS_URL=redis://localhost:6379
APP_TIMEZONE=Asia/Kolkata
PUBLIC_BASE_URL=
PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Sign-in (SRS 7). off = local dev; bitrix = Sign in with Bitrix24 (needs the three below).
AUTH=off
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
# 32+ random characters, e.g. from: openssl rand -base64 48
SESSION_SECRET=
# --- NFR-9 health: working days (1 = Mon) and hours, in APP_TIMEZONE.
WORK_DAYS=1,2,3,4,5,6
WORK_HOURS=10-19
# --- Production only (docker-compose.prod.yml)
# SITE_ADDRESS=140-238-1-2.sslip.io
# POSTGRES_PASSWORD=
