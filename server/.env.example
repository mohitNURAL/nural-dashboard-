# ---------------------------------------------------------------------------
# Nural CRM Dashboard — backend configuration
# Copy to server/.env. Never commit the real .env (SRS §5.1, §7 Security).
# ---------------------------------------------------------------------------

PORT=4000

# Bitrix24 inbound webhook (SRS §5.1 option 1), scoped to `crm` + `user`.
# Format: https://<portal>.bitrix24.in/rest/<user_id>/<token>/
# Leave EMPTY to run in MOCK mode (seeded sample data, same Bitrix-shaped payloads).
BITRIX_WEBHOOK_URL=

# Application token Bitrix24 sends with outbound event webhooks
# (ONCRMDEALUPDATE, ONCRMLEADUPDATE, …). Point the events at POST /api/bitrix/events.
BITRIX_EVENT_TOKEN=

# Near real-time: every N seconds, fetch only deals/leads modified since the
# last check (2–3 small REST calls). Minimum 5. Open dashboards update via push.
QUICK_SYNC_SECONDS=15

# Full re-pull in minutes — backstop that also catches deleted records.
SYNC_INTERVAL_MINUTES=10

# Reporting pipeline source. Empty: Bitrix deal pipelines (CATEGORY_ID).
# Set to a deal list field when all deals sit on one Kanban board and the
# product line is a field — on nural.bitrix24.in that is "Product":
# DEAL_PIPELINE_FIELD=UF_CRM_6A0C44C019860
DEAL_PIPELINE_FIELD=

# Lead pipeline tag (SRS §6.5 open item 4). On nural.bitrix24.in: the lead
# "Product" field UF_CRM_1778559138719 (options are matched to the deal field by name). Custom lead field that holds the
# deal CATEGORY_ID a lead belongs to, e.g. UF_CRM_1712345678. Leave empty until
# Phase 0 decides — lead pipeline write-back is then disabled (value write still works).
LEAD_PIPELINE_FIELD=

# Dashboard users (SRS §3). JSON array of { token, name, role } with role
# "viewer" or "admin" (Pipeline admin). Leave EMPTY for local development:
# every request is then treated as an admin named "local-dev".
# DASHBOARD_USERS=[{"token":"change-me-admin","name":"Deepak","role":"admin"},{"token":"change-me-view","name":"Sales","role":"viewer"}]
DASHBOARD_USERS=
