# Nural dashboard (SRS 7). SITE_ADDRESS is the public host, e.g. 140-238-1-2.sslip.io: Caddy gets
# its Let's Encrypt certificate and redirects HTTP to HTTPS. Use http://localhost for a local test.
{$SITE_ADDRESS} {
	encode gzip

	# Optional extras from the server (not in git), e.g. the interim shared password.
	import /etc/caddy/extra/*.caddy

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Sign in with Bitrix24: the portal returns to the local app's handler path (the site root)
	# with ?code=&state=, ignoring redirect_uri; hand that to the API's callback.
	@oauthReturn {
		path /
		query code=* state=*
	}
	redir @oauthReturn /api/auth/callback?{query} 302

	@backend path /api/* /hooks/* /health
	handle @backend {
		# flush_interval -1: Server-Sent Events (/api/stream) pass through unbuffered.
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
